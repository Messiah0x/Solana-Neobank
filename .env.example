# ─── Helius RPC ──────────────────────────────────────────────────────────────
HELIUS_API_KEY=your_helius_api_key_here

# ─── Solana Network ───────────────────────────────────────────────────────────
# Options: mainnet-beta | devnet
SOLANA_NETWORK=devnet

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/solana_neobank

# ─── Encryption ───────────────────────────────────────────────────────────────
# 32+ character random string used to AES-256-GCM encrypt private keys at rest
# Generate: openssl rand -hex 32
ENCRYPTION_SECRET=your_32_character_minimum_secret_here

# ─── Backend Server ───────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3000

# ─── Marginfi ─────────────────────────────────────────────────────────────────
# No API key needed — Marginfi is permissionless. The SDK uses HELIUS_API_KEY
# for RPC. On devnet, APY falls back to 8.4% if the devnet group is unavailable.

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── Privy (Authentication) ───────────────────────────────────────────────────
# dashboard.privy.io → your app → App settings
# Frontend (publishable):
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id
# Backend token verification (REQUIRED in production — without these the API
# falls back to trusting client-supplied user IDs):
PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret

# ─── Error Monitoring (optional) ──────────────────────────────────────────────
# sentry.io → project → Client Keys (DSN). Sentry is a no-op when unset.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# ─── Coin Flip (Double or Nothing) ────────────────────────────────────────────
# Base58-encoded secret key of the house wallet that holds the game bankroll.
# Bets are paid into it; 2x payouts are paid out of it. The game returns 503
# when unset. Generate a dedicated wallet (never reuse another key):
#   node -e "const{Keypair}=require('@solana/web3.js');const b=require('bs58');const k=Keypair.generate();console.log('pubkey:',k.publicKey.toString());console.log('secret:',b.encode(k.secretKey))"
# Fund it with devnet SOL + USDC, and keep the bankroll small.
HOUSE_WALLET_SECRET=
# Per-flip bet caps (defaults: 1 SOL / 100 USDC)
FLIP_MAX_BET_SOL=1
FLIP_MAX_BET_USDC=100
