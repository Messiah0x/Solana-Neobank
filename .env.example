# ─── Helius RPC ──────────────────────────────────────────────────────────────
HELIUS_API_KEY=your_helius_api_key_here

# ─── Solana Network ───────────────────────────────────────────────────────────
# Options: mainnet-beta | devnet
SOLANA_NETWORK=devnet

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/solana_neobank

# ─── Encryption ───────────────────────────────────────────────────────────────
# 32+ character random string used to AES-256-GCM encrypt private keys at rest
# Generate: openssl rand -hex 32
ENCRYPTION_SECRET=your_32_character_minimum_secret_here

# ─── Backend Server ───────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3000

# ─── Marginfi ─────────────────────────────────────────────────────────────────
# No API key needed — Marginfi is permissionless. The SDK uses HELIUS_API_KEY
# for RPC. On devnet, APY falls back to 8.4% if the devnet group is unavailable.

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── NextAuth (Authentication) ────────────────────────────────────────────────
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
# Set to your production URL on Vercel, e.g. https://your-app.vercel.app
NEXTAUTH_URL=http://localhost:3000

# Google OAuth — console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth — github.com/settings/developers → OAuth Apps → New OAuth App
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
