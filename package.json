{
  "name": "solana-neobank",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "dev": "concurrently \"npm run dev --workspace=packages/backend\" \"npm run dev --workspace=packages/frontend\"",
    "build": "npm run build --workspaces",
    "db:generate": "npm run db:generate --workspace=packages/backend",
    "db:push": "npm run db:push --workspace=packages/backend",
    "db:migrate": "npm run db:migrate --workspace=packages/backend",
    "db:studio": "npm run db:studio --workspace=packages/backend"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "uuid": "^8.3.2",
    "rpc-websockets": {
      "uuid": "^8.3.2"
    }
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "patch-package": "^8.0.1"
  }
}
